{
  "name": "kotaru",
  "private": true,
  "version": "0.0.1",
  "description": "Kotaru \u2014 AI companion. Monorepo root.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:arch": "node tools/check-architecture.mjs",
    "demo": "tsx apps/gateway/src/demo.ts",
    "db:migrate": "tsx apps/gateway/src/migrate-cli.ts",
    "test:pg": "vitest run apps/gateway/test/postgres.test.ts",
    "db:retention": "tsx apps/gateway/src/retention-cli.ts",
    "build:gateway": "node tools/build-gateway.mjs",
    "dev:token": "tsx apps/gateway/src/token-cli.ts",
    "start:gateway": "tsx apps/gateway/src/main.ts",
    "smoke": "tsx apps/gateway/src/smoke-cli.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
