# /etc/kotaru/gateway.env — permisos 640, root:kotaru. NUNCA en git.
# install.sh lo genera solo la primera vez; despues no lo toca.

DATABASE_URL=postgres://kotaru:CLAVE@127.0.0.1:5432/kotaru

# Claves de firma: "kid:base64" separadas por coma. La primera firma; todas verifican.
# Para rotar: anade la nueva DELANTE, espera a que caduquen los tokens viejos, quita la vieja.
KOTARU_GRANT_KEYS=g1:BASE64_DE_32_BYTES_O_MAS
KOTARU_ACCESS_KEYS=a1:OTRA_CLAVE_DISTINTA

HOST=127.0.0.1
PORT=8080
KOTARU_GRANT_AUDIENCE=kotaru-gateway
KOTARU_API_AUDIENCE=kotaru-api

# Tope de gasto mensual en proveedores de IA. Al acercarse se degrada calidad y al
# llegar se corta la voz. ASSUMPTION: 50 USD mientras se prueba.
KOTARU_MONTHLY_HARD_CAP_USD=50
KOTARU_MESSAGE_RETENTION_DAYS=30

# Proveedores de IA: mock (simulados, gratis) o los reales: assemblyai,gemini,polly.
# Ver "Activar los proveedores reales" en deploy/README.md antes de cambiarlo.
KOTARU_PROVIDERS=mock

# --- Solo si se activan los reales ---
# ASSEMBLYAI_API_KEY=
# KOTARU_ASSEMBLYAI_ZERO_RETENTION_CONFIRMED=false
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# KOTARU_GEMINI_PAID_TIER_CONFIRMED=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# KOTARU_POLLY_AI_OPT_OUT_CONFIRMED=false
# KOTARU_POLLY_COMMERCIAL_TERMS_REVIEWED=false

# --- Login con Apple / Google ---
# Se activa al poner al menos una lista de client ids. Las claves del correo se generan
# una vez y NO se cambian: con otra clave, los correos guardados no se pueden leer.
KOTARU_APPLE_CLIENT_IDS=app.kotaru.mobile
KOTARU_GOOGLE_CLIENT_IDS=
KOTARU_EMAIL_HASH_KEY=BASE64_DE_32_BYTES
KOTARU_EMAIL_ENCRYPTION_KEY=OTRA_BASE64_DE_32_BYTES
# true solo con Caddy delante: el limite por IP usa X-Forwarded-For.
KOTARU_TRUST_PROXY=false
