# Webapp de Kotaru (https://app.kotaru.app) para el Caddy compartido de srv1987174.
# deploy/web.sh la compila, deja los archivos en /etc/caddy/otros-sitios/kotaru-web (la
# unica carpeta del servidor que ese contenedor ve y que RapiMula no reescribe) y copia
# este archivo junto a ellos.
app.kotaru.app {
	root * /etc/caddy/otros-sitios/kotaru-web
	# Ademas de lo habitual (texto, JS, JSON), los modelos 3D: sus mallas bajan a la mitad.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
			header Content-Type model/gltf-binary*
		}
	}
	@avatar path /avatars/*.vrm
	header @avatar {
		Content-Type model/gltf-binary
		Cache-Control "public, max-age=86400"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# El microfono solo para esta pagina; nada de camara ni ubicacion.
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		# Solo scripts propios y los de login de Google y Apple. El token de sesion vive en
		# sessionStorage: esta politica es lo que impide que un script ajeno lo lea.
		# blob: en img-src y connect-src: el visor 3D saca las texturas del propio modelo .vrm
		# como blob (nunca de fuera); los scripts siguen sin admitir blob.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://appleid.cdn-apple.com; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; connect-src 'self' blob: https://api.kotaru.app wss://api.kotaru.app https://accounts.google.com/gsi/ https://appleid.apple.com; frame-src https://accounts.google.com/gsi/ https://appleid.apple.com; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self' data:; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	# Los archivos de /_expo llevan un hash en el nombre: se pueden guardar para siempre.
	@hashed path /_expo/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@page path / /index.html
	header @page Cache-Control "no-cache"

	# Verificacion de dominio para las passkeys de las apps nativas (JSON, sin redirigir).
	@wellknown path /.well-known/apple-app-site-association /.well-known/assetlinks.json
	header @wellknown Content-Type application/json
	handle @wellknown {
		file_server
	}

	# Cualquier otra ruta es la app (una sola pagina).
	try_files {path} /index.html
	file_server
}
