# Kotaru — nombres de variables. NUNCA valores reales en este archivo.
# Los secretos viven en el gestor de secretos del servidor, jamas en el cliente.

NODE_ENV=development

# --- Enrutado ---
# Ruta de voz primaria. modular | realtime
KOTARU_VOICE_ROUTE=modular
# Proveedor activo por capacidad. mock = simulador local determinista.
KOTARU_STT_PROVIDER=mock
KOTARU_LLM_PROVIDER=mock
KOTARU_TTS_PROVIDER=mock
KOTARU_MODERATION_PROVIDER=mock
KOTARU_EMBEDDING_PROVIDER=mock

# --- Topes de gasto (USD) ---
KOTARU_BUDGET_SESSION_USD=0.50
KOTARU_BUDGET_MONTHLY_USD=800
KOTARU_BUDGET_HARD_CAP_USD=1000

# --- Claves de proveedor (vacias en desarrollo; se inyectan desde el secrets manager) ---
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
TOGETHER_API_KEY=
DEEPGRAM_API_KEY=
